{
  "//": "Blocks to merge into the `hooks` section of ~/.claude/settings.json. Append each block AT THE END of the matching event array (or create the array if missing). Adjust the script path to where the plugin is installed (TPM default shown; XDG setups use ~/.config/tmux/plugins/).",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh working", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh working_soft", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh working_soft", "timeout": 5 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh working_soft", "timeout": 5 }] }
    ],
    "Notification": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh notification", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh waiting", "timeout": 5 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh waiting", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh session_end", "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh subagent_start", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh subagent_end", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "/bin/sh ~/.tmux/plugins/tmux-claude-status/scripts/claude-status-hook.sh error", "timeout": 5 }] }
    ]
  }
}
